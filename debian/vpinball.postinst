#!/bin/sh
set -e

# postinst script for vpinball
# Called after installation of the package

case "$1" in
    configure)
        # Create user configuration directory
        if [ ! -d "/home/$SUDO_USER/.config/vpinball" ]; then
            mkdir -p "/home/$SUDO_USER/.config/vpinball"
        fi

        # Create IA Assistant configuration directory
        mkdir -p "/home/$SUDO_USER/.config/vpinball/tables"
        mkdir -p "/home/$SUDO_USER/.config/vpinball/tables/iaassistant"

        # Install example configuration if it doesn't exist
        if [ ! -f "/home/$SUDO_USER/.config/vpinball/iaassistant.conf" ]; then
            if [ -f "/usr/share/doc/vpinball-common/iaassistant.conf.example" ]; then
                cp /usr/share/doc/vpinball-common/iaassistant.conf.example \
                   "/home/$SUDO_USER/.config/vpinball/iaassistant.conf"
                chown "$SUDO_USER:$SUDO_USER" "/home/$SUDO_USER/.config/vpinball/iaassistant.conf"
            fi
        fi

        # Update desktop database
        if command -v update-desktop-database >/dev/null 2>&1; then
            update-desktop-database -q
        fi

        # Update icon cache
        if [ -d "/usr/share/icons/hicolor" ] && command -v gtk-update-icon-cache >/dev/null 2>&1; then
            gtk-update-icon-cache -q -t /usr/share/icons/hicolor
        fi

        # Print welcome message
        echo ""
        echo "========================================"
        echo "Visual Pinball X a été installé avec succès!"
        echo "========================================"
        echo ""
        echo "Le plugin IA Assistant est inclus et prêt à l'emploi."
        echo ""
        echo "Pour configurer votre provider IA:"
        echo "  nano ~/.config/vpinball/iaassistant.conf"
        echo ""
        echo "Pour tester l'application:"
        echo "  vpinball          # Mode jeu"
        echo "  vpinball -LiveEdit # Mode éditeur"
        echo ""
        echo "Pour plus d'infos sur le plugin IA:"
        echo "  zcat /usr/share/doc/vpinball-common/IA_ASSISTANT_PLUGIN.md.gz"
        echo ""
    ;;

    abort-upgrade|abort-remove|abort-failed)
        ;;

    *)
        echo "postinst called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

#DEBHELPER#

exit 0