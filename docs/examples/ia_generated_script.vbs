Option Explicit

' Global variables
Dim g_ModeStarted, g_GameMode, g_MultiballMode
Dim g_BallCount, g_BallLocks, g_ScoreMultiplier
Dim g_LastTime, g_CurrentTime

' ================================================
' Table Load and Initialization
' ================================================

Sub TableLoad()
    ' Initialise les paramètres de base
    g_ModeStarted = False
    g_GameMode = 0
    g_MultiballMode = False
    g_BallCount = 0
    g_BallLocks = 0
    g_ScoreMultiplier = 1

    ' Configure les sons par défaut
    InitSound

    ' Initialise les lumières
    InitLights

    ' Configure les modelets
    g_PrevBall = 0
    g_PrevTime = Timer
End Sub

Sub TableOpen()
    ' Action à la fermeture de la table
    If g_GameMode > 0 Then
        ResetGameModes
    End If
End Sub

' ================================================
' Mode Game
' ================================================

Sub GameMode()
    ' Mode principal du jeu
    g_GameMode = 1

    ' Active les lumières de base
    LightSequence("start_sequence", -1) ' Boucle infinie

    ' Initialise le score
    Score(1000, "Game Start")
End Sub

Sub ResetGameModes()
    ' Réinitialise tous les modes
    g_MultiballMode = False
    g_BallLocks = 0
    g_ScoreMultiplier = 1
    LightStop
End Sub

' ================================================
' Bumpers
' ================================================

Sub AlienBumper1_Hit()
    Score 500, "Alien Bumper"
    FlashLED AlienBumper1, "hit"
    Sound.Play "bumper_alien.wav"
End Sub

Sub AlienBumper2_Hit()
    Score 100, "Alien Bumper"
    FlashLED AlienBumper2, "hit"
    Sound.Play "bumper_small.wav"
End Sub

Sub AlienBumper3_Hit()
    Score 100, "Alien Bumper"
    FlashLED AlienBumper3, "hit"
    Sound.Play "bumper_small.wav"
End Sub

' ================================================
' Flippers
' ================================================

Sub LeftFlipper()
    ' Logique du flipper gauche
    If GameInfo.GameType = "Single" Then
        ' Mode simple
    ElseIf g_MultiballMode = True Then
        ' Mode multiball
        Score 10, "Flipper Hit"
    End If
End Sub

Sub RightFlipper()
    ' Logique du flipper droit
    If g_MultiballMode = True Then
        Score 10, "Flipper Hit"
    End If
End Sub

' ================================================
' Targets
' ================================================

Sub Target1_Hit()
    Score 100, "Target"
    FlashLED Target1, "hit"
    Sound.Play "target_hit.wav"
End Sub

Sub Target2_Hit()
    Score 100, "Target"
    FlashLED Target2, "hit"
    Sound.Play "target_hit.wav"
End Sub

Sub DropTarget1_Hit()
    Score 500, "Drop Target"
    FlashLED DropTarget1, "hit"
    Sound.Play "drop_target_down.wav"

    ' Vérifie si tous les drop targets sont touchés
    CheckDropTargets
End Sub

Sub DropTarget1_Unhit()
    EnableLED DropTarget1, "lit"
    Sound.Play "drop_target_up.wav"
End Sub

Sub CheckDropTargets()
    ' Logique pour vérifier les drop targets
    Dim total_hits
    total_hits = (IIf(Target1.Lit, 1, 0) + _
                  IIf(Target2.Lit, 1, 0) + _
                  IIf(DropTarget1.Lit, 1, 0))

    If total_hits = 3 Then
        ' Tous les targets touchés !
        Score 1000, "All Targets!"
        LightSequence "multiball_sequence", 1
    End If
End Sub

' ================================================
' Silloscopes
' ================================================

Sub Silloscope1_Hit()
    g_BallLocks = g_BallLocks + 1
    Score 500, "Silloscope Lock"
    FlashLED Silloscope1, "lit"
    Sound.Play "lock.wav"

    If g_BallLocks >= 3 Then
        ' Multiball déclenché !
        StartMultiball
    End If
End Sub

Sub StartMultiball()
    g_MultiballMode = True
    g_BallCount = 3
    Score 5000, "Multiball Started!"
    LightSequence "multiball_lights", -1

    ' Active des modes spéciaux
    ModeActivate "Multiball", 0, 1
End Sub

' ================================================
' Drain
' ================================================

Sub BallDrain()
    ' Débogage : vérifie si la balle est tombée
    If g_BallCount = 0 And g_MultiballMode = True Then
        EndMultiball
    End If

    Sound.Play "ball_drain.wav"
End Sub

Sub EndMultiball()
    g_MultiballMode = False
    g_BallCount = 0
    g_BallLocks = 0
    Score g_BallCount * 1000, "Multiball End"
    LightSequence "reset_lights", 2
End Sub

' ================================================
' Triggers
' ================================================

Sub LaunchTrigger()
    g_BallCount = g_BallCount + 1
    Score 100, "Launch"
End Sub

' ================================================
' Lights
' ================================================

Sub InitLights()
    ' Cette fonction initialise les lumières
    LightColor StartLight, 255, 0, 0  ' Rouge
    LightEnable StartLight, 0  ' Éteint
End Sub

Sub StartLight_Trigger()
    LightEnable StartLight, 1  ' Allume
    LightSequence "start_sequence", 5
    Sound.Play "light_sequence.wav"
End Sub

' ================================================
' Sound System
' ================================================

Sub InitSound()
    ' Initialise le système audio
    Sound.Add "bumper_alien.wav", "bumpers/bumper1.wav"
    Sound.Add "bumper_small.wav", "bumpers/bumper2.wav"
    Sound.Add "target_hit.wav", "targets/target_hit.wav"
    Sound.Add "drop_target_down.wav", "targets/drop_down.wav"
    Sound.Add "drop_target_up.wav", "targets/drop_up.wav"
    Sound.Add "lock.wav", "locks/lock.wav"
    Sound.Add "ball_drain.wav", "drain/ball_down.wav"
End Sub

' ================================================
' Scoring Helpers
' ================================================

Function IIf(expression, true_value, false_value)
    If expression Then
        IIf = true_value
    Else
        IIf = false_value
    End If
End Function

Sub BonusMultiplier()
    g_ScoreMultiplier = g_ScoreMultiplier * 2
    Score 500, "Multiplier x2"
End Sub

' ================================================
' Game Events
' ================================================

Sub PlayerScore_BallSaved()
    ' Balle sauvée par le catcher
    Score 100, "Ball Saved"
End Sub

Sub PlayerScore_BallLost()
    ' Balle perdue
    If g_GameMode > 0 Then
        Score -100, "Ball Lost"
    End If
End Sub

